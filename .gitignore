# Unity cache/temp/build
*/Library/
*/Temp/
*/Obj/
*/Build/
*/Builds/
*/Logs/
*/MemoryCaptures/

# VSCode
.vscode/

# OS junk
.DS_Store
Thumbs.db

# Build artifacts
*.apk
*.aab
*.unitypackage

# Rider / VS
.idea/
*.sln
*.csproj
*.user
*.pidb
*.booproj
*.suo
.vs/

# Logs and profiler
*.log
*.profiler

# Optional: If you include unit tests or samples and want to skip certain generated folders
*/bin/
*/obj/

/Spoke.Runtime.meta
/Spoke.Runtime/**/*.meta
/Spoke.Reactive.meta
/Spoke.Reactive/**/*.meta
/Spoke.Unity.meta
/Spoke.Unity/**/*.meta
/Spoke.Godot.meta
/Spoke.Godot/**/*.meta
/LICENSE.meta
/README.md.meta
/CHANGELOG.md.meta
/Examples.meta
/Docs.meta
/Docs/**/*.meta

# Godot generates a .uid file per script. Keeps the repo easy to browse.
/Spoke.Runtime/**/*.uid
/Spoke.Reactive/**/*.uid
/Spoke.Godot/**/*.uid

# ...except under Examples. The example scenes reference their scripts by uid rather than by path,
# so they keep working wherever Spoke is installed in a consuming project. That only holds if the
# uid files are committed alongside them.
!/Spoke.Godot/Examples/**/*.uid

# The hand-authored test project lives in the Unity-ignored Tests~ folder.
# It is NOT an auto-generated csproj, so re-include it despite the *.csproj rule above.
!/Tests~/Spoke.Tests.csproj